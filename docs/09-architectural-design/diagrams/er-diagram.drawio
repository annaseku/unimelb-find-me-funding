        </mxCell>
        <mxCell id="note_p" value="&lt;b&gt;provenance_json&lt;/b&gt;&lt;br/&gt;maps each Opportunity field name to the stage that set it: &lt;i&gt;rule&lt;/i&gt;, &lt;i&gt;llm&lt;/i&gt; or &lt;i&gt;missing&lt;/i&gt;. This is the audit trail for LLM-derived values." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingRight=14;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;strokeWidth=1.2;fillColor=#FFFBEB;strokeColor=#D9A91A;" vertex="1" parent="1">
