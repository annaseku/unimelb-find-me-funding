        <mxCell id="t_opp" value="&lt;i&gt;&amp;#171;crawler raw store&amp;#187;&lt;/i&gt;&lt;br/&gt;&lt;b&gt;opportunities&lt;/b&gt;&lt;hr size='1'/&gt;&lt;b&gt;url&lt;/b&gt; : TEXT &amp;nbsp;&lt;i&gt;PK&lt;/i&gt;&lt;br/&gt;title : TEXT&lt;br/&gt;raw_text : TEXT&lt;br/&gt;deadline_raw : TEXT&lt;br/&gt;deadline_parsed : TEXT&lt;br/&gt;funding_amount_raw : TEXT&lt;br/&gt;eligibility_snippet : TEXT&lt;br/&gt;source_query : TEXT&lt;br/&gt;first_seen_at : TEXT&lt;br/&gt;fetched_at : TEXT&lt;br/&gt;fetch_failed : INTEGER DEFAULT 0" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;strokeWidth=1.5;fillColor=#FEE2E2;strokeColor=#DC2626;" vertex="1" parent="1">
          <mxGeometry x="80" y="160" width="380" height="215" as="geometry" />
        </mxCell>
        <mxCell id="t_norm" value="&lt;i&gt;&amp;#171;normalised store&amp;#187;&lt;/i&gt;&lt;br/&gt;&lt;b&gt;normalised_opportunities&lt;/b&gt;&lt;hr size='1'/&gt;&lt;b&gt;id&lt;/b&gt; : TEXT &amp;nbsp;&lt;i&gt;PK&lt;/i&gt;&lt;br/&gt;&lt;b&gt;url&lt;/b&gt; : TEXT &amp;nbsp;&lt;i&gt;UNIQUE, FK&lt;/i&gt;&lt;br/&gt;content_hash : TEXT NOT NULL&lt;br/&gt;opportunity_json : JSONB NOT NULL&lt;br/&gt;provenance_json : JSONB NOT NULL&lt;br/&gt;used_llm : BOOLEAN DEFAULT FALSE&lt;br/&gt;normalised_at : TIMESTAMPTZ DEFAULT now()" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;strokeWidth=1.5;fillColor=#FEE2E2;strokeColor=#DC2626;" vertex="1" parent="1">
          <mxGeometry x="80" y="465" width="380" height="165" as="geometry" />
        </mxCell>
