        <mxCell id="r1b" value="0..1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#1F2937;strokeColor=none;fillColor=none;" vertex="1" parent="1">
