        </mxCell>
        <mxCell id="note_j" value="&lt;b&gt;Why JSONB, not normalised tables?&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;An Opportunity has eight list-valued attributes (citizenships, employer types, career stages, funding types, FoR codes, ToA codes, keywords, source URLs). Fully normalising these would need eight join tables for data that is only ever read as a whole object by &lt;i&gt;OpportunityRepository.all()&lt;/i&gt;.&lt;br/&gt;&lt;br/&gt;JSONB keeps the read path to one query and lets the shape evolve without a migration. The trade-off is that the database cannot enforce the inner structure &amp;#8212; Pydantic does that at the application boundary instead." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingRight=14;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;strokeWidth=1.2;fillColor=#FFFBEB;strokeColor=#D9A91A;" vertex="1" parent="1">
          <mxGeometry x="80" y="665" width="380" height="200" as="geometry" />
        </mxCell>
        <mxCell id="logi" value="Logical model inside opportunity_json" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#7C3AED;verticalAlign=top;spacingTop=6;dashed=1;dashPattern=6 4;strokeWidth=1.3;fillColor=#EDE9FE;fillOpacity=35;strokeColor=#7C3AED;" vertex="1" parent="1">
          <mxGeometry x="530" y="120" width="660" height="775" as="geometry" />
        </mxCell>
        <mxCell id="l_op" value="&lt;i&gt;&amp;#171;entity&amp;#187;&lt;/i&gt;&lt;br/&gt;&lt;b&gt;Opportunity&lt;/b&gt;&lt;hr size='1'/&gt;&lt;b&gt;id&lt;/b&gt; : str &amp;nbsp;&lt;i&gt;PK&lt;/i&gt;&lt;br/&gt;title : str&lt;br/&gt;funder : str&lt;br/&gt;url : str&lt;br/&gt;summary : str&lt;br/&gt;amount_aud : int | None&lt;br/&gt;amount_note : str&lt;br/&gt;deadline : date | None&lt;br/&gt;opens_at : date | None&lt;br/&gt;eligibility_text : str&lt;br/&gt;status : OpportunityStatus" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;strokeWidth=1.5;fillColor=#EDE9FE;strokeColor=#7C3AED;" vertex="1" parent="1">
