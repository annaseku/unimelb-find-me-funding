        <mxCell id="note_e" value="An empty list means the funder states no restriction (or none was found) &amp;#8212; never &quot;nobody&quot;. This distinction is load-bearing in the eligibility scorer, which returns four states rather than a yes/no." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingRight=14;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;strokeWidth=1.2;fillColor=#FFFBEB;strokeColor=#D9A91A;" vertex="1" parent="1">
