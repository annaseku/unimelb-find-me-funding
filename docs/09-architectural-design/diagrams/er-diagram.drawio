        <mxCell id="t3" value="// Physical schema as created by backend/crawler/storage.py and backend/data/postgres_repository.py.&lt;br/&gt;// The normalised record is stored as JSONB, so its logical entities are shown separately on the right." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#4B5563;strokeColor=none;fillColor=none;" vertex="1" parent="1">
