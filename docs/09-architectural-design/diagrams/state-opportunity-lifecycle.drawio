        <mxCell id="n1" value="&lt;b&gt;content_hash short-circuit.&lt;/b&gt; On a re-crawl the SHA-256 of title plus raw text is compared first. If it is unchanged the page skips normalisation entirely, so an unchanged funder page costs one fetch and no LLM call." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingRight=14;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;strokeWidth=1.2;fillColor=#FFFBEB;strokeColor=#D9A91A;" vertex="1" parent="1">
          <mxGeometry x="780" y="556" width="370" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;Soft delete.&lt;/b&gt; A closed opportunity keeps its row and is filtered out by the ranker at read time unless the search sets &lt;i&gt;include_closed&lt;/i&gt;. History is never destroyed by a deadline passing." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingRight=14;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;strokeWidth=1.2;fillColor=#FFFBEB;strokeColor=#D9A91A;" vertex="1" parent="1">
