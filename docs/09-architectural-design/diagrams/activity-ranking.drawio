        <mxCell style="html=1;rounded=1;arcSize=10;fontFamily=Helvetica;fontSize=11;fontColor=#374151;strokeColor=#374151;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;startArrow=none;startFill=1;endSize=8;startSize=8;endSize=10;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;entryPerimeter=0;" id="x12b" value="" edge="1" parent="1" source="m2" target="a8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell style="html=1;rounded=1;arcSize=10;fontFamily=Helvetica;fontSize=11;fontColor=#374151;strokeColor=#374151;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;startArrow=none;startFill=1;endSize=8;startSize=8;endSize=10;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;entryPerimeter=0;" id="x13" value="" edge="1" parent="1" source="a8" target="a9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell style="html=1;rounded=1;arcSize=10;fontFamily=Helvetica;fontSize=11;fontColor=#374151;strokeColor=#374151;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;startArrow=none;startFill=1;endSize=8;startSize=8;endSize=10;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;entryPerimeter=0;" id="x14" value="SearchResponse" edge="1" parent="1" source="a9" target="f0">
          <mxGeometry relative="1" as="geometry" x="0.0">
            <mxPoint x="56" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n1" value="&lt;b&gt;Why four separate scores.&lt;/b&gt; Confluence decision 5: the criteria are scored independently and all four are returned alongside the overall, so the UI can show &lt;i&gt;why&lt;/i&gt; an opportunity ranked where it did rather than showing an unexplained number." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingRight=14;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;strokeWidth=1.2;fillColor=#FFFBEB;strokeColor=#D9A91A;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="250" height="118" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;Weights are open.&lt;/b&gt; The defaults put eligibility first because the client called it the top priority, but the relative weighting is still an open team decision &amp;#8212; see &lt;i&gt;docs/ranking-discussion-points.md&lt;/i&gt;. A request may override any subset of them." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingRight=14;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;strokeWidth=1.2;fillColor=#FFFBEB;strokeColor=#D9A91A;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="250" height="128" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;Regression guard.&lt;/b&gt; &lt;i&gt;backend/evals/run_evals.py&lt;/i&gt; scores a golden set through this same path on every CI run, so a weight or scorer change that degrades ranking fails the build." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;spacingRight=14;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;strokeWidth=1.2;fillColor=#FFFBEB;strokeColor=#D9A91A;" vertex="1" parent="1">
          <mxGeometry x="40" y="750" width="250" height="104" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
