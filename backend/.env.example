# Copy this file to backend/.env and fill in only what you need.
# .env is gitignored and must never be committed. This file is the committed
# list of variable names, so it carries no real values.

# Optional. Enables the normaliser's LLM extractor (python -m backend.normaliser.run),
# which fills the prose-derived fields the rules cannot reach. Without it the
# normaliser runs rules-only; the API, the tests and the evals never need it.
# Also reserved for the LLM research-match scorer, not started; its seam is
# _text_overlap in ranking/research_match.py.
#
# An OpenRouter key (openrouter.ai/keys), pay-as-you-go credits. Read by
# backend/normaliser/llm.py.
# Set FMF_LLM=off to skip the extractor even when the key is present;
# FMF_LLM_MODEL overrides the default model (qwen/qwen3-30b-a3b-instruct-2507)
# with any OpenRouter model id that supports structured outputs.
OPENROUTER_API_KEY=

# Required only when FMF_DATA_SOURCE=postgres (the deployed API, and locally
# when you want to read Postgres rather than the default local SQLite database).
# Read by backend/data/postgres_repository.py, which loads this file on import.
#
# MUST be the Supabase Supavisor *session mode* pooler URL, port 5432. The
# direct string (db.<ref>.supabase.co) publishes only an IPv6 address, and
# Render is IPv4-only, so a direct URL works locally and fails once deployed.
# Transaction mode (port 6543) does not support prepared statements, which
# psycopg uses. Copy the exact value from the Supabase dashboard's Connect
# button, session mode. In production this lives in the Render dashboard.
#
# postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
FMF_DATABASE_URL=
