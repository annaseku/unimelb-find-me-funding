# Copy this file to backend/.env and fill in only what you need.
# .env is gitignored and must never be committed. This file is the committed
# list of variable names, so it carries no real values.

# Optional. Nothing in the backend reads it yet, so the API, the tests and the
# evals all run without it. Eligibility, funding value and deadline scoring are
# deterministic, and research match uses keyword overlap; the LLM seam is
# _text_overlap in ranking/research_match.py. Set this only if you are building
# the LLM research-match or eligibility-prose scorer.
ANTHROPIC_API_KEY=
